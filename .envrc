# Standardized dev environment for pp. Requires: direnv + opam.
#
#   direnv allow     # once, to trust this file
#   dune build       # then `pp file.pp`, `dune runtest`, `dune exec ...` just work
#
# Loads the active opam switch so dune/ocaml are on PATH (no `opam exec --`
# prefix), and puts the built interpreter on PATH as `pp` (via bin/pp, a
# symlink to the dune build output — dangling until the first `dune build`).
eval "$(opam env)"
PATH_add bin
