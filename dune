; `dune runtest` — the single-engine test suite. Runs from the build root so
; test files can `(load "stdlib/list.pp")`. The driver checks expected output
; and runs the shell oracles. See docs/TESTING.md.
(env
 (dev
  (flags (:standard -warn-error @1..3@5..28@30..39@43@46..47@49..57@61..62-40))))

(rule
 (alias runtest)
 (deps
  (source_tree tests)
  (source_tree src)
  (source_tree tools)
  (source_tree stdlib)
  (source_tree demo)
  (source_tree examples)
  ; tests/055's whole-tree `pp fmt` round-trip sweep also covers the
  ; manual's live-executed .pp examples
  (source_tree docs/manual)
  ; tests/067 diffs SPEC's generated surface-tables block against
  ; `pp --dump-surface-tables`, so the SPEC file must be a runtest dep.
  docs/SPEC.md
  tests/fixtures/adversarial/honest-edges.tsv
  build.pp
  scripts/run-tests.sh
  scripts/run-focused-tests.sh
  scripts/test-categories.sh
  scripts/check-architecture.sh
  scripts/check-state-inventory.sh
  scripts/state-inventory.allow
  tools/check-compiler-warnings.sh
  tools/check-dependencies.sh
  tools/check-api-surface.sh
  tools/api-surface.allow
  tools/check-vertical-slices.sh
  tools/dependency-manifest
  tools/check_value_constructors.exe
  src/app/main.exe
  tools/fuzz.exe
  tests/unit/kernel_unit.exe
  tests/unit/repository_unit.exe
  tests/unit/observation_unit.exe
  tests/unit/lifecycle_unit.exe
  tests/unit/parser_unit.exe)
 (action
 (progn
  (run bash scripts/check-architecture.sh)
  (run %{dep:tools/check_value_constructors.exe} --root .)
  (run bash scripts/run-focused-tests.sh
    %{dep:tests/unit/kernel_unit.exe}
    %{dep:tests/unit/repository_unit.exe}
    %{dep:tests/unit/observation_unit.exe}
    %{dep:tests/unit/lifecycle_unit.exe}
    %{dep:tests/unit/parser_unit.exe})
  (run bash scripts/run-tests.sh src/app/main.exe))))

; Keep the standard-library mirror current for the interpreter and fuzzer.
; Keep both executables in the default build.
(rule
 (alias default)
 (deps (source_tree stdlib) src/app/main.exe tools/fuzz.exe tools/check-dependencies.sh)
 (action (progn)))

(rule
 (alias architecture)
 (deps scripts/check-architecture.sh tools/check-compiler-warnings.sh
   tools/check-dependencies.sh tools/dependency-manifest tools/check-api-surface.sh
   tools/api-surface.allow tools/check-vertical-slices.sh
   scripts/check-state-inventory.sh
   scripts/state-inventory.allow dune src/kernel/dune src/frontend/dune
   src/runtime/dune src/app/dune tools/check_value_constructors.exe
   (source_tree src) (source_tree tools) (source_tree tests/unit))
 (action
  (progn
   (run bash scripts/check-architecture.sh)
   (run %{dep:tools/check_value_constructors.exe} --root .))))

(rule
 (alias unit)
 (deps scripts/run-focused-tests.sh
   tests/unit/kernel_unit.exe tests/unit/repository_unit.exe
   tests/unit/observation_unit.exe tests/unit/lifecycle_unit.exe
   tests/unit/parser_unit.exe)
 (action (run bash scripts/run-focused-tests.sh
   %{dep:tests/unit/kernel_unit.exe}
   %{dep:tests/unit/repository_unit.exe}
   %{dep:tests/unit/observation_unit.exe}
   %{dep:tests/unit/lifecycle_unit.exe}
   %{dep:tests/unit/parser_unit.exe})))
