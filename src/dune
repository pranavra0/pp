; pp.kernel is pure — no Unix, no side-effects — so it needs no
; -no-strict-sequence override. The kernel's sequences are all unit-typed
; let-bindings; dune's default -strict-sequence is the correct default here.
(library
 (name pp_kernel)
 (public_name pp.kernel)
 (wrapped false)
 (modules source_error core_model identity environment value_analysis free_vars presentation quotation pattern_match invocation effects evaluator_ops host_services hasher blobref force_deep codec constant_time
   paths cell surface_tables capability desugar comments version cap_token nfc)
 (libraries cryptokit dune-build-info))

; -no-strict-sequence: same rationale as main below — pp uses ; for
; side-effecting expressions where the return value is naturally non-unit
; (e.g., Hashtbl.replace, output_string, Unix.write_substring).
(library
 (name pp)
 (public_name pp)
 (wrapped false)
 (modules fswalk session dynamic_scope world_path observation store_layout object_repository blob_repository trace_repository repository_inventory cache_policy cell_repository store_index sandbox loader error_context journal gcroots node kernel_props
   reader reader_braces printer_braces printer_sexpr
   process scheduler domain_prims fenced island primitives domains
   evaluator macro stabilize repl
   transport remote store_gc lint)
 (libraries pp.kernel unix)
 (flags -no-strict-sequence))

; Thin entry point: reads the flag table, builds the invocation record,
; dispatches.  The pp library carries everything else.
(executable
 (name main)
 (public_name pp)
 (modules main)
 (libraries pp cryptokit dune-build-info)
 ; -no-strict-sequence: dune's default -strict-sequence treats every
 ; non-unit left-hand side of a sequence as an error. pp uses ; for
 ; side-effecting expressions where the return value is naturally non-unit
 ; (e.g., Hashtbl.replace, output_string, Unix.write_substring). Removing
 ; this would require prefixing hundreds of existing calls with ignore,
 ; adding noise without improving safety — sequences are already
 ; side-effect-by-convention; the value thrown away is never relied on.
 (flags -no-strict-sequence))
