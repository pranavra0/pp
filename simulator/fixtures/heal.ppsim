scenario v1 {
  seed: 4, program: { file: "../examples/nodes.pp", argv: [] },
  hosts: { control: { cores: 1, store: cold }, worker: { cores: 1, store: cold } },
  links: [{ id: work, from: control, to: worker, latency: "20ms", bandwidth: "100mbit", loss: "0%" }],
  grants: [], actions: [{ at: "0ms", partition: work }, { at: "25ms", heal: work }],
  expect: [{ eventually: { event: "fault.heal" } }, { eventually: { event: "network.response" } }]
}
